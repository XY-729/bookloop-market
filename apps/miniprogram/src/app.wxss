page{background:#f6f7f0;color:#304d3c;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,button,input,textarea{box-sizing:border-box}button{font-size:27rpx;border-radius:16rpx;line-height:2.9}button::after{border:0}.page{padding:30rpx 28rpx 50rpx}.card{background:#fff;border:1rpx solid #e7ebdf;border-radius:22rpx;padding:28rpx;margin-bottom:22rpx}.heading{font-size:40rpx;font-weight:600;margin-bottom:12rpx}.sub{font-size:24rpx;color:#8c9887;line-height:1.8}.eyebrow{font-size:19rpx;letter-spacing:4rpx;color:#879f82;margin-bottom:14rpx}.primary{background:#276b56;color:white}.secondary{background:#eaf0e4;color:#39684e}.danger{background:#fff0e9;color:#ad6445}.btn-row{display:flex;gap:16rpx;margin-top:26rpx;flex-wrap:wrap}.btn-row button{flex:1;margin:0;min-width:180rpx}.empty{text-align:center;padding:90rpx 30rpx;color:#9aa491;line-height:2}.price{color:#aa7250;font-size:36rpx;font-weight:600}.tag{background:#edf2e5;color:#608057;padding:6rpx 14rpx;border-radius:8rpx;font-size:21rpx;display:inline-block;margin:8rpx 8rpx 8rpx 0}.tag.warn{background:#fff2da;color:#a47c3e}.row{display:flex;justify-content:space-between;align-items:center;gap:18rpx}.label{font-size:25rpx;font-weight:500;margin:25rpx 0 14rpx}.input{background:#f6f8f1;border:1rpx solid #e7ebdf;border-radius:14rpx;padding:22rpx 24rpx;width:100%;min-height:80rpx}.textarea{height:170rpx}.picker{background:#f6f8f1;border:1rpx solid #e7ebdf;border-radius:14rpx;padding:23rpx}.note{color:#8a977e;font-size:23rpx;line-height:1.8;margin:18rpx 0}.divider{height:1rpx;background:#edf0e5;margin:24rpx 0}.error{background:#fff0e9;color:#a36b48;border-radius:14rpx;padding:20rpx;margin-bottom:20rpx;font-size:25rpx}.loading{text-align:center;color:#8d9a80;padding:20rpx}.title{font-size:29rpx;font-weight:600;line-height:1.6}.cover{width:130rpx;height:170rpx;border-radius:12rpx;background:#e3e9dc;flex-shrink:0}.item{display:flex;gap:24rpx;align-items:center}.item-content{flex:1;min-width:0}.time{font-size:21rpx;color:#9aa48e}.bottom{position:fixed;bottom:0;left:0;right:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e5eadd;display:flex;gap:20rpx;z-index:10}.bottom button{flex:1;margin:0}.with-bottom{padding-bottom:200rpx}.image-upload{width:100%;height:240rpx;background:#edf2e5;border:2rpx dashed #d9e3cd;border-radius:16rpx;display:flex;align-items:center;justify-content:center;color:#839574;font-size:26rpx}.image-upload image{width:100%;height:100%;border-radius:14rpx}.proof-note{background:#edf2e5;padding:24rpx;border-radius:16rpx;color:#6b8060;font-size:24rpx;line-height:1.9}
