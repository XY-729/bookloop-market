<view class="page"><view class="heading">{{kind==='terms'?'用户协议':'隐私政策'}}</view><view wx:if="error" class="error">{{error}}</view><block wx:if="document"><view class="sub">版本：{{kind==='terms'?document.versions.terms:document.versions.privacy}}</view><view class="sub">运营方：{{document.operator}}</view><view class="error" wx:if="!document.configured">当前为内部测试文本，正式运营主体和联系方式尚未配置。</view><view wx:for="{{kind==='terms'?document.terms:document.privacy}}" wx:key="title" class="card"><view class="title">{{item.title}}</view><view class="legal-body">{{item.body}}</view></view><view class="note">联系运营方：{{document.contact}}</view></block></view>
