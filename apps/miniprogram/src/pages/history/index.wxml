<view class="page"><view class="heading">浏览记录</view><view class="sub">最近看过的教材，方便再找到。</view><view wx:for="{{items}}" wx:key="id" class="card item" data-id="{{item.id}}" bindtap="detail"><image src="{{item.frontUrl}}" class="cover" mode="aspectFill"/><view class="item-content"><view class="title">{{item.title}}</view><view class="price">¥{{item.yuan}}</view></view><text class="sub">›</text></view><view wx:if="!items.length" class="empty">还没有浏览记录</view></view>
