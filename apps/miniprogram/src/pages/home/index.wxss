.search{display:flex;background:#fff;border:1rpx solid #e1e8d8;border-radius:18rpx;margin:32rpx 0 24rpx;padding:8rpx}.search input{flex:1;padding:20rpx;font-size:25rpx}.search button{background:#276b56;color:#fff;padding:0 25rpx;font-size:24rpx;margin:0;line-height:2.9}.categories{white-space:nowrap;margin-bottom:26rpx}.chip{display:inline-block;background:#edf1e6;color:#81916f;padding:15rpx 23rpx;border-radius:30rpx;font-size:23rpx;margin-right:14rpx}.chip.selected{background:#276b56;color:white}.announcement{display:flex;align-items:center;gap:18rpx;background:#eeeede;border-radius:16rpx;padding:22rpx;font-size:23rpx;color:#85815f;margin-bottom:14rpx}.announcement>text:first-child{font-size:21rpx;color:#a29a6d}.arrow{margin-left:auto}.section-title{display:flex;justify-content:space-between;margin:36rpx 0 24rpx;font-weight:600;font-size:29rpx}.section-title>text:last-child{font-size:22rpx;color:#98a18b;font-weight:400}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.book{background:#fff;border:1rpx solid #e7ebdf;border-radius:19rpx;overflow:hidden}.book>image{width:100%;height:320rpx;background:#e1e8d8}.book-body{padding:20rpx}.book .title{font-size:26rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.book .sub{font-size:21rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:10rpx 0 15rpx}.book .price{font-size:29rpx}.book .tag{font-size:18rpx;padding:5rpx 9rpx;margin:0}.end{font-size:22rpx;text-align:center;color:#a9b29d;margin:45rpx 0}.dev-note{color:#a08856;font-size:21rpx;margin-top:18rpx}
