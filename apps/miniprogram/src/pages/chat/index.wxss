.chat-page{height:100vh;display:flex;flex-direction:column}.chat-scroll{flex:1;height:0;padding:20rpx 28rpx}.chat-tip,.older{font-size:21rpx;text-align:center;color:#98a38c;padding:20rpx}.message{display:flex;flex-direction:column;align-items:flex-start;margin:25rpx 0}.message.mine{align-items:flex-end}.message-time{color:#a1ab95;font-size:19rpx;align-self:center;margin:12rpx}.bubble{max-width:85%;background:white;border-radius:18rpx;padding:22rpx 26rpx;word-break:break-all;font-size:27rpx;line-height:1.7}.mine .bubble{background:#dfead4;color:#365f3e}.bubble image{width:300rpx;max-height:400rpx;border-radius:12rpx}.product-card{width:330rpx}.chat-compose{background:#fff;padding:20rpx 25rpx calc(20rpx + env(safe-area-inset-bottom))}.chat-tools{display:flex;gap:35rpx;color:#7c8d70;font-size:23rpx;margin-bottom:20rpx}.composer{display:flex;gap:18rpx;align-items:center}.composer input{flex:1;padding:20rpx;background:#f3f6ee;border-radius:14rpx;font-size:25rpx}.composer button{margin:0;padding:0 27rpx;font-size:24rpx}.spacer{height:30rpx}
