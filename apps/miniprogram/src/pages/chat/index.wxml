<view class="chat-page"><scroll-view scroll-y class="chat-scroll" scroll-into-view="{{scrollInto}}" scroll-with-animation><view wx:if="hasMore" class="older" bindtap="older">查看更早消息</view><view class="chat-tip">请在线下交付，核实教材版本与成色后确认收货。</view><view wx:for="{{messages}}" wx:key="id" id="m-{{item.id}}" class="message {{item.mine?'mine':''}}"><view class="message-time">{{item.time}}</view><view class="bubble"><text wx:if="item.kind==='TEXT'">{{item.body}}</text><image wx:if="item.kind==='IMAGE'&&item.image" src="{{item.image}}" mode="widthFix" data-url="{{item.image}}" bindtap="preview"/><text wx:if="item.kind==='IMAGE'&&!item.image">图片暂不可用</text><view wx:if="item.kind==='PRODUCT'" class="product-card" data-id="{{item.body}}" bindtap="book"><text class="tag">教材卡片</text><view>{{item.card?item.card.title:'教材已下架'}}</view></view></view></view><view class="spacer"/></scroll-view><view class="chat-compose"><view class="chat-tools"><text bindtap="imageSend">＋ 图片</text><text bindtap="cardSend">＋ 教材卡片</text></view><view class="composer"><input value="{{text}}" bindinput="input" bindconfirm="textSend" maxlength="2000" placeholder="和用户聊聊教材…" confirm-type="send"/><button class="primary" bindtap="textSend" disabled="{{busy||!text}}" loading="{{busy}}">发送</button></view></view></view>
