<view class="page"><view class="profile-top"><view class="avatar">书</view><view><view class="heading">{{me?me.nickname:'欢迎来到BookLoop 教材'}}</view><view class="sub">{{me?(me.verified?'用户身份已审核':'完成认证后可发布、购买和聊天'):'登录后，让教材继续流转'}}</view></view></view><view class="consent" wx:if="{{!me||!me.consent.accepted}}"><checkbox-group bindchange="policyChange"><label><checkbox value="agree" checked="{{accepted}}" color="#276b56"/>我已阅读并同意</label></checkbox-group><text data-kind="privacy" bindtap="policy">隐私政策</text><text>和</text><text data-kind="terms" bindtap="policy">用户协议</text></view><button wx:if="me&&!me.consent.accepted" class="primary" bindtap="accept" disabled="{{!accepted||busy}}" loading="{{busy}}">同意并继续使用</button><button wx:if="!me" class="primary" bindtap="login" loading="{{busy}}">{{dev?'开发环境：登录模拟买家':'微信登录'}}</button><view wx:if="me&&!me.verified" class="card verify-card" data-page="verify" bindtap="go"><view><view class="title">用户认证</view><view class="sub">{{me.verification?me.verification.status==='PENDING'?'已提交，等待管理员审核':me.verification.reason:'上传认证材料，审核后开放交易'}}</view></view><text>›</text></view><view class="menu card"><view data-page="orders" data-query="?role=buyer" bindtap="go"><text>我的购买</text><text>›</text></view><view data-page="sales" bindtap="go"><text>我的售卖</text><text>›</text></view><view data-page="orders" data-query="?role=seller" bindtap="go"><text>售卖订单</text><text>›</text></view><view data-page="funds" bindtap="go"><text>资金记录</text><text>›</text></view><view data-page="history" bindtap="go"><text>浏览记录</text><text>›</text></view><view data-page="complaint" bindtap="go"><text>我的投诉</text><text>›</text></view></view><view class="policy-links"><text data-kind="privacy" bindtap="policy">隐私政策</text><text data-kind="terms" bindtap="policy">用户协议</text><text wx:if="me.consent.accepted" bindtap="revoke">撤回同意</text></view><view class="note">收到教材并核对版本、成色后再确认收货。退款或交付问题请及时在订单内申请处理。</view><view wx:if="dev" class="dev-panel"><view class="sub">仅开发环境可切换模拟身份</view><button class="secondary" bindtap="seller">切换为模拟卖家</button></view><button wx:if="me" class="secondary" bindtap="logout">退出登录</button></view>
