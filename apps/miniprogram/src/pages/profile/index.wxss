.profile-top{display:flex;gap:24rpx;align-items:center;margin:35rpx 0 40rpx}.profile-top .heading{font-size:33rpx}.avatar{width:110rpx;height:110rpx;display:flex;align-items:center;justify-content:center;background:#dfe9d5;color:#558057;border-radius:50%;font-size:39rpx;flex-shrink:0}.verify-card{display:flex;align-items:center;justify-content:space-between;margin-top:25rpx}.menu{margin-top:32rpx;padding:10rpx 28rpx}.menu>view{padding:30rpx 0;display:flex;justify-content:space-between;border-bottom:1rpx solid #edf0e5}.menu>view:last-child{border:0}.menu>view>text:last-child{color:#a0ad95;font-size:34rpx}.dev-panel{padding:30rpx 0}.dev-panel button{margin-top:18rpx}

.consent{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx;font-size:23rpx;color:#859377;margin-bottom:24rpx}.consent checkbox{transform:scale(.75)}.consent>text[data-kind],.policy-links>text{color:#276b56}.policy-links{display:flex;flex-wrap:wrap;gap:25rpx;font-size:23rpx;margin:30rpx 0}
