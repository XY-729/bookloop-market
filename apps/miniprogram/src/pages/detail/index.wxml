<view class="page with-bottom"><view wx:if="error" class="error">{{error}}</view><view wx:if="loading" class="loading">正在加载教材…</view><block wx:if="book"><swiper class="book-swiper" indicator-dots><swiper-item><image src="{{book.frontUrl}}" mode="aspectFit" bindtap="preview"/></swiper-item><swiper-item><image src="{{book.backUrl}}" mode="aspectFit" bindtap="preview"/></swiper-item></swiper><view class="card"><view class="row"><text class="price">¥{{book.yuan}}</text><text class="tag">线下交付</text></view><view class="heading book-title">{{book.title}}</view><view><text class="tag">{{book.category}}</text><text class="tag">{{book.topic}}</text><text class="tag">{{book.location}}</text></view><view class="divider"/><view class="label">教材成色</view><view class="sub">{{book.condition}}</view><view class="label">交付说明</view><view class="sub">{{book.handoff}}</view></view><view class="card"><view class="row"><text>{{book.seller.nickname}}</text><text class="tag">{{book.seller.verified?'用户身份已审核':'身份未审核'}}</text></view><view class="note">请通过聊天核对教材版本、笔记和交付地点。具体交付地点和时间须由双方协商确认。</view></view><view class="bottom"><button class="secondary" bindtap="chat">联系卖家</button><button class="primary" bindtap="buy" disabled="{{book.status!=='ACTIVE'||book.seller.banned}}">{{book.status==='ACTIVE'?'立即购买':book.status==='RESERVED'?'已被锁定':'已售出'}}</button></view></block></view>
