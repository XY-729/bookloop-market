{
  "name": "bookloop-market",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/admin",
    "apps/miniprogram"
  ],
  "scripts": {
    "check:release": "node scripts/check-release.mjs",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node scripts/test.mjs",
    "dev:db": "node scripts/local-db.mjs",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.23.1",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": false,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true,
    "sharp@0.35.5": true
  }
}
